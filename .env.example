# 실제 키가 담긴 .env 파일은 절대 GitHub에 올리지 않는다.
# 이 파일을 복사해서 .env로 만들고 실제 발급받은 키를 채워 넣는다.
# cp .env.example .env

# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=

# Claude(Anthropic API)를 대신 쓰고 싶을 때만 필요
# LLM_PROVIDER=anthropic일 때 사용
ANTHROPIC_API_KEY=

# gemini 또는 anthropic
# 비워두면 기본값 gemini로 동작한다.
LLM_PROVIDER=gemini

# 로컬에 aws configure를 해뒀다면 아래 값은 비워둬도 됨
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AUDIT_LOG_BUCKET=ogwanwan-shop-bucket

HOST=web-01
RAW_LOG_WINDOW_MINUTES=10

# EC2 서버에 로그가 저장되는 경로로 변경해야 함

# 2026-09-22 주의: 조사 도구(fetch_web_log.py 등)가 apache access.log 기반
# 공통 정규화 함수로 바뀌면서, WEB_LOG_LOCAL_PATH는 이제 "apache 포맷" 샘플을
# 가리켜야 한다. sample_logs/sample_web.log는 예전 nginx JSON 샘플이라 이제 이
# 변수엔 안 맞는다(그 파일 자체는 raw_log_ingestion.py의 아직 안 옮긴 seed용
# web 수집 branch가 계속 쓰니 지우지 말 것 — 거긴 여전히 nginx 포맷을 기대함).
WEB_LOG_LOCAL_PATH=sample_logs/sample_web.log
AUTH_LOG_LOCAL_PATH=sample_logs/sample_auth.log
AUDIT_LOG_LOCAL_PATH=sample_logs/sample_audit.log
NETWORK_LOG_LOCAL_PATH=sample_logs/sample_network.log