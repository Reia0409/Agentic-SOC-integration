# .env 로 복사해서 실제 경로/값을 채운다:  cp .env.example .env

# 로그 경로 (없으면 각 파서의 기본 /var/log/... 경로 사용)
APACHE_LOG_PATH=tools/sample_access.log        # 실 배포: /var/log/apache2/access.log
AUTH_LOG_PATH=tools/sample_auth.log            # 실 배포: /var/log/auth.log
SURICATA_LOG_PATH=tools/sample_eve.json        # 실 배포: /var/log/suricata/eve.json
AUDIT_LOG_PATH=/var/log/audit/audit.log        # 실 배포: /var/log/audit/audit.log

# auth: BSD syslog 헤더엔 연도가 없어 여기서 지정
AUTH_LOG_YEAR=2026

# web: 서버 자기 공인 IP (wp-cron 자기호출 제외, exclude_self 대상)
SERVER_PUBLIC_IP=54.180.11.0
